    {
      "name": "06 Listar categor?as (ms-catalog)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{catalogUrl}}/api/v1/categories?active=true",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{requesterToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "var c = pm.response.json();",
              "pm.test(\"Hay categor?as\", function () { pm.expect(c.length).to.be.above(0); });",
              "pm.environment.set(\"categoryId\", c[0].id);"
            ]
          }
        }
      ]
    },
