    {
      "name": "08 Crear ticket (SOLICITANTE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ticketsUrl}}/api/v1/tickets",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{requesterToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Impresora sin red\",\n  \"description\": \"La impresora del piso 2 no responde desde ayer\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"priorityId\": \"{{priorityId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "var t = pm.response.json();",
              "pm.environment.set(\"ticketId\", t.id);",
              "pm.test(\"Estado ABIERTO\", function () { pm.expect(t.status).to.eql(\"ABIERTO\"); });"
            ]
          }
        }
      ]
    },
