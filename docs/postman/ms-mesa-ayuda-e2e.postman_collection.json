{
  "info": {
    "name": "ms-mesa-ayuda E2E",
    "description": "Flujo E2E: registro/login, ticket, asignaci?n, EN_PROGRESO, RESUELTO, CERRADO e historial. Ejecutar en orden (Collection Runner) con el entorno ms-mesa-ayuda-local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Registrar SOLICITANTE (p?blico)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usersUrl}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{requesterEmail}}\",\n  \"password\": \"{{requesterPassword}}\",\n  \"fullName\": \"Solicitante E2E\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var s = Date.now();",
              "if (!pm.environment.get(\"requesterEmail\")) { pm.environment.set(\"requesterEmail\", \"solicitante-\" + s + \"@example.com\"); }",
              "if (!pm.environment.get(\"agentEmail\")) { pm.environment.set(\"agentEmail\", \"agente-\" + s + \"@example.com\"); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Rol SOLICITANTE\", function () { pm.expect(pm.response.json().role).to.eql(\"SOLICITANTE\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usersUrl}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.environment.set(\"adminToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear AGENTE (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
