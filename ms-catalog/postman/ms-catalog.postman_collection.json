{
  "info": {
    "_postman_id": "7c1e2a10-0000-4000-8000-000000000001",
    "name": "ms-catalog (Práctica 1)",
    "description": "Pruebas de todos los endpoints de /api/v1 de ms-catalog. Ejecuta las peticiones en orden: el flujo crea una categoría y la reutiliza. Requiere el servicio arriba en {{baseUrl}} y la base catalog_db con datos semilla (V2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "categoryId", "value": "3", "type": "string" },
    { "key": "priorityId", "value": "2", "type": "string" },
    { "key": "newCategoryId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y estado UP', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Categorías (HU-CAT-01 a HU-CAT-04)",
      "item": [
        {
          "name": "HU-CAT-01 Listar todas las categorías",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con lista', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-01 Listar solo categorías activas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?active=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"],
              "query": [{ "key": "active", "value": "true" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y todas activas', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.json().forEach(function (c) { pm.expect(c.active).to.eql(true); });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-01 Consultar categoría por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-01 [Negativo] Categoría inexistente -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 CATEGORY_NOT_FOUND con ProblemDetail', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.response.to.have.header('Content-Type', /problem\\+json/);",
                  "  pm.expect(pm.response.json().code).to.eql('CATEGORY_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-02 Crear categoría -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Redes\",\n  \"description\": \"Problemas de red\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con Location y active=true', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.response.to.have.header('Location');",
                  "  pm.expect(pm.response.json().active).to.eql(true);",
                  "  pm.collectionVariables.set('newCategoryId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-02 [Negativo] Nombre duplicado -> 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Software\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 CATEGORY_ALREADY_EXISTS', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().code).to.eql('CATEGORY_ALREADY_EXISTS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-02 [Negativo] Nombre de 1 carácter -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_ERROR con errors[].field = name', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(pm.response.json().errors[0].field).to.eql('name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-03 Modificar categoría -> 200",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Accesos y cuentas\",\n  \"description\": \"Contraseñas y permisos\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con nombre actualizado', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().name).to.eql('Accesos y cuentas');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-03 [Negativo] Usar nombre de otra categoría -> 409",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Software\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 CATEGORY_ALREADY_EXISTS', function () {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-03 [Negativo] Modificar categoría inexistente -> 404",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Redes\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/categories/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 CATEGORY_NOT_FOUND', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().code).to.eql('CATEGORY_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-04 Desactivar categoría (borrado lógico) -> 204",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/categories/{{newCategoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 sin cuerpo', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-04 Verificar que la categoría desactivada sigue existiendo (active=false)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories/{{newCategoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y active=false', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().active).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-04 [Negativo] Desactivar categoría inexistente -> 404",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/categories/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 CATEGORY_NOT_FOUND', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Prioridades y SLA (HU-CAT-05 a HU-CAT-07)",
      "item": [
        {
          "name": "HU-CAT-05 Listar prioridades ordenadas por nivel",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/priorities"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con 4 prioridades en orden de nivel', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var levels = pm.response.json().map(function (p) { return p.level; });",
                  "  pm.expect(levels).to.eql([1, 2, 3, 4]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-05 Consultar prioridad por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/priorities/{{priorityId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con SLA', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().sla).to.have.property('responseHours');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-05 [Negativo] Prioridad inexistente -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/priorities/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 PRIORITY_NOT_FOUND', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().code).to.eql('PRIORITY_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-06 [Negativo] Crear prioridad con código existente (ALTA) -> 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"ALTA\",\n  \"name\": \"Alta\",\n  \"level\": 5,\n  \"sla\": { \"responseHours\": 1, \"resolutionHours\": 2 }\n}"
            },
            "url": "{{baseUrl}}/api/v1/priorities"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 PRIORITY_ALREADY_EXISTS', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().code).to.eql('PRIORITY_ALREADY_EXISTS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-06 [Negativo] Crear prioridad con código fuera del dominio (URGENTE) -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"URGENTE\",\n  \"name\": \"Urgente\",\n  \"level\": 5,\n  \"sla\": { \"responseHours\": 1, \"resolutionHours\": 2 }\n}"
            },
            "url": "{{baseUrl}}/api/v1/priorities"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 MALFORMED_REQUEST', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('MALFORMED_REQUEST');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-07 Actualizar SLA -> 200",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responseHours\": 2,\n  \"resolutionHours\": 8\n}"
            },
            "url": "{{baseUrl}}/api/v1/priorities/{{priorityId}}/sla"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con nuevas horas', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().sla.responseHours).to.eql(2);",
                  "  pm.expect(pm.response.json().sla.resolutionHours).to.eql(8);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-07 [Negativo] Resolución menor que respuesta -> 400",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responseHours\": 10,\n  \"resolutionHours\": 5\n}"
            },
            "url": "{{baseUrl}}/api/v1/priorities/{{priorityId}}/sla"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 con errors[].field = resolutionHours', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().errors[0].field).to.eql('resolutionHours');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-07 [Negativo] Horas de respuesta en 0 -> 400",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responseHours\": 0,\n  \"resolutionHours\": 5\n}"
            },
            "url": "{{baseUrl}}/api/v1/priorities/{{priorityId}}/sla"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_ERROR', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-CAT-07 [Negativo] Actualizar SLA de prioridad inexistente -> 404",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responseHours\": 2,\n  \"resolutionHours\": 8\n}"
            },
            "url": "{{baseUrl}}/api/v1/priorities/999999/sla"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 PRIORITY_NOT_FOUND', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().code).to.eql('PRIORITY_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
