# Variables de entorno de ms-catalog.
# Copia este archivo a .env (no se versiona) y ajusta los valores. Ejemplo: set -a; . ./.env; set +a

SERVER_PORT=8080

CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5435
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=cambia-esta-clave

SWAGGER_ENABLED=true

CATALOG_SLA_MAX_RESPONSE_HOURS=720
CATALOG_SLA_MAX_RESOLUTION_HOURS=2160

# Obligatoria: misma clave que ms-users (mínimo 32 bytes). No la versiones con un valor real.
JWT_SECRET=cambia-esta-clave-de-al-menos-32-bytes
JWT_ISSUER=ms-users
JWT_AUDIENCE=mesa-ayuda
SERVICES_USERS_URL=http://localhost:8081

# Solo para ./mvnw -B verify (Dependency-Check).
NVD_API_KEY=cambia-por-tu-clave-nvd
