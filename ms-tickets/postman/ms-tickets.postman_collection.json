{
	"info": {
		"name": "ms-tickets",
		"description": "Pruebas de los endpoints de /api/v1/tickets con autenticación JWT (Bearer) emitido por ms-users. Antes de ejecutar, rellena en las variables de colección los correos y contraseñas de cada rol, y los IDs reales de agentId y requesterId (ver ms-users). Los tokens se guardan automáticamente al ejecutar las peticiones de login.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8082" },
		{ "key": "usersUrl", "value": "http://localhost:8081" },
		{ "key": "adminEmail", "value": "" },
		{ "key": "adminPassword", "value": "" },
		{ "key": "agentEmail", "value": "" },
		{ "key": "agentPassword", "value": "" },
		{ "key": "requesterEmail", "value": "" },
		{ "key": "requesterPassword", "value": "" },
		{ "key": "otherEmail", "value": "" },
		{ "key": "otherPassword", "value": "" },
		{ "key": "agentId", "value": "2" },
		{ "key": "requesterId", "value": "10" },
		{ "key": "adminToken", "value": "" },
		{ "key": "agentToken", "value": "" },
		{ "key": "requesterToken", "value": "" },
		{ "key": "otherToken", "value": "" },
		{ "key": "ticketId", "value": "1" }
	],
	"item": [
		{
			"name": "0. Autenticación (ms-users)",
			"item": [
				{
					"name": "0a. Login ADMIN",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"email\": \"{{adminEmail}}\",\n\t\"password\": \"{{adminPassword}}\"\n}"
						},
						"url": "{{usersUrl}}/api/v1/auth/login"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login ADMIN responde 200', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "0b. Login AGENTE",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"email\": \"{{agentEmail}}\",\n\t\"password\": \"{{agentPassword}}\"\n}"
						},
						"url": "{{usersUrl}}/api/v1/auth/login"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login AGENTE responde 200', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('agentToken', pm.response.json().accessToken);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "0c. Login SOLICITANTE",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"email\": \"{{requesterEmail}}\",\n\t\"password\": \"{{requesterPassword}}\"\n}"
						},
						"url": "{{usersUrl}}/api/v1/auth/login"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login SOLICITANTE responde 200', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('requesterToken', pm.response.json().accessToken);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "0d. Login SOLICITANTE ajeno",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"email\": \"{{otherEmail}}\",\n\t\"password\": \"{{otherPassword}}\"\n}"
						},
						"url": "{{usersUrl}}/api/v1/auth/login"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login SOLICITANTE ajeno responde 200', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('otherToken', pm.response.json().accessToken);"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "1. Crear ticket (SOLICITANTE)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{requesterToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"title\": \"Impresora sin red\",\n\t\"description\": \"La impresora del piso 2 no responde desde ayer\",\n\t\"categoryId\": 1,\n\t\"priorityId\": 2\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 201', () => pm.response.to.have.status(201));",
							"pm.test('Incluye Location', () => pm.response.to.have.header('Location'));",
							"pm.test('Estado inicial ABIERTO', () => pm.expect(pm.response.json().status).to.eql('ABIERTO'));",
							"pm.collectionVariables.set('ticketId', pm.response.json().id);"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "2. Crear ticket con título vacío (400) [negativo]",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{requesterToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"title\": \"\",\n\t\"description\": \"La impresora del piso 2 no responde desde ayer\",\n\t\"categoryId\": 1,\n\t\"priorityId\": 2\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 400', () => pm.response.to.have.status(400));",
							"pm.test('Código VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));",
							"pm.test('Lista errors con el campo title', () => pm.expect(pm.response.json().errors[0].field).to.eql('title'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "3. Listar mis tickets (SOLICITANTE)",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{requesterToken}}" }],
				"url": "{{baseUrl}}/api/v1/tickets"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200 con arreglo', () => {",
							"  pm.response.to.have.status(200);",
							"  pm.expect(pm.response.json()).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "3b. Listar mis tickets filtrados por estado ABIERTO (SOLICITANTE)",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{requesterToken}}" }],
				"url": {
					"raw": "{{baseUrl}}/api/v1/tickets?status=ABIERTO",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "tickets"],
					"query": [{ "key": "status", "value": "ABIERTO" }]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200', () => pm.response.to.have.status(200));",
							"pm.test('Todos los tickets están ABIERTO', () => pm.expect(pm.response.json().every(t => t.status === 'ABIERTO')).to.be.true);"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "4. Consultar ticket por ID (dueño)",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{requesterToken}}" }],
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200', () => pm.response.to.have.status(200));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "5. Consultar ticket ajeno (403) [negativo]",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 403', () => pm.response.to.have.status(403));",
							"pm.test('Código FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "6. Consultar ticket inexistente (404) [negativo]",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
				"url": "{{baseUrl}}/api/v1/tickets/999999"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 404', () => pm.response.to.have.status(404));",
							"pm.test('Código TICKET_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('TICKET_NOT_FOUND'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "7. Asignar ticket a agente (ADMIN)",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{adminToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"assigneeId\": {{agentId}}\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/assignment"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200', () => pm.response.to.have.status(200));",
							"pm.test('Estado ASIGNADO', () => pm.expect(pm.response.json().status).to.eql('ASIGNADO'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "8. Asignar por SOLICITANTE (403) [negativo]",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{requesterToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"assigneeId\": {{agentId}}\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/assignment"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 403', () => pm.response.to.have.status(403));",
							"pm.test('Código FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "9. Cambiar estado a EN_PROGRESO (AGENTE asignado)",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{agentToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"status\": \"EN_PROGRESO\",\n\t\"comment\": \"Revisando el equipo\"\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/status"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200', () => pm.response.to.have.status(200));",
							"pm.test('Estado EN_PROGRESO', () => pm.expect(pm.response.json().status).to.eql('EN_PROGRESO'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "10. Transición inválida (409) [negativo]",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{agentToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"status\": \"ABIERTO\"\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/status"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 409', () => pm.response.to.have.status(409));",
							"pm.test('Código TICKET_INVALID_TRANSITION', () => pm.expect(pm.response.json().code).to.eql('TICKET_INVALID_TRANSITION'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "11. Consultar historial (ADMIN)",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/history"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200 con arreglo', () => {",
							"  pm.response.to.have.status(200);",
							"  pm.expect(pm.response.json()).to.be.an('array');",
							"});",
							"pm.test('Cada evento incluye eventType y changedAt', () => {",
							"  pm.response.json().forEach(e => {",
							"    pm.expect(e).to.have.property('eventType');",
							"    pm.expect(e).to.have.property('changedAt');",
							"  });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "12. Petición sin token (401) [negativo]",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/v1/tickets"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 401', () => pm.response.to.have.status(401));",
							"pm.test('Código UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "13. Resolver ticket (AGENTE asignado)",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{agentToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"status\": \"RESUELTO\",\n\t\"comment\": \"Impresora reconfigurada\"\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/status"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200', () => pm.response.to.have.status(200));",
							"pm.test('Estado RESUELTO', () => pm.expect(pm.response.json().status).to.eql('RESUELTO'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "14. Cerrar por AGENTE asignado (403) [negativo]",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{agentToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"status\": \"CERRADO\"\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/status"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 403', () => pm.response.to.have.status(403));",
							"pm.test('Código FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "15. Cerrar por SOLICITANTE dueño",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{requesterToken}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n\t\"status\": \"CERRADO\",\n\t\"comment\": \"Confirmo la solución\"\n}"
				},
				"url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/status"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Responde 200', () => pm.response.to.have.status(200));",
							"pm.test('Estado CERRADO', () => pm.expect(pm.response.json().status).to.eql('CERRADO'));",
							"pm.test('Incluye closedAt', () => pm.expect(pm.response.json().closedAt).to.not.be.null);"
						],
						"type": "text/javascript"
					}
				}
			]
		}
	]
}
