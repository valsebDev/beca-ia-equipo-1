# Copiar a .env (no se versiona) y completar. Los secretos quedan vacíos a propósito:
# si se dejan sin valor, el servicio no arranca (JWT_SECRET) o no crea el administrador inicial.
PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/users_db
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=10
ADMIN_EMAIL=
ADMIN_PASSWORD=
