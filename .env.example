# Copia este archivo a .env y reemplaza los placeholders. .env nunca se versiona.

# Bases de datos (una por servicio)
USERS_DB_USER=users
USERS_DB_PASSWORD=CAMBIA_ESTA_CLAVE
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=CAMBIA_ESTA_CLAVE
TICKETS_DB_USER=tickets
TICKETS_DB_PASSWORD=CAMBIA_ESTA_CLAVE

# JWT compartido (ms-users emite; ms-users, ms-catalog y ms-tickets validan)
JWT_SECRET=CAMBIA_ESTE_SECRETO_DE_AL_MENOS_32_BYTES
JWT_ISSUER=ms-users
JWT_AUDIENCE=mesa-ayuda

# Administrador inicial de ms-users
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE

# Solo para ejecutar ./mvnw verify en local o en CI (OWASP Dependency-Check)
NVD_API_KEY=TU_NVD_API_KEY
