# Base de datos de ms-users (PostgreSQL)
USERS_DB_USER=usuario_db_users
USERS_DB_PASSWORD=reemplazar_por_password_db_users

# Seguridad JWT de ms-users (JWT_SECRET: mínimo 32 caracteres aleatorios)
JWT_SECRET=reemplazar_por_secreto_jwt
JWT_ISSUER=ms-users
JWT_AUDIENCE=mesa-ayuda

# Administrador inicial creado por ms-users si aún no existe ninguno
ADMIN_EMAIL=reemplazar_por_email_admin
ADMIN_PASSWORD=reemplazar_por_password_admin
